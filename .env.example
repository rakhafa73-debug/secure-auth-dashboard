# =============================================================================
# SecureAuth — Environment Configuration
# =============================================================================
# Copy this file to `.env.local` and fill in the values below.
#   cp .env.example .env.local
#
# NEVER commit `.env.local` or any real key to version control.
# Only the Supabase *anon* public key belongs here. The `service_role` key
# MUST NEVER be exposed to the browser or bundled into the frontend.
# =============================================================================

# Supabase project URL — Settings > API > Project URL
VITE_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"

# Supabase anon/public key — Settings > API > Project API keys > anon public
# This key is safe for the browser ONLY when Row Level Security is enabled.
VITE_SUPABASE_ANON_KEY="YOUR-ANON-PUBLIC-KEY"

# Public site URL used to build safe auth redirect links (email confirmation,
# password recovery). Must exactly match an entry in your Supabase
# Authentication > URL Configuration > Redirect URLs allow-list.
# Local dev: http://localhost:5173
# Production: https://your-domain.com
VITE_SITE_URL="http://localhost:5173"
